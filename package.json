{
  "name": "navcraft",
  "private": true,
  "type": "module",
  "workspaces": [
    "src/harness-pi/pi/coding-agent"
  ],
  "scripts": {
    "build:pi": "npm run build --workspace @earendil-works/pi-coding-agent",
